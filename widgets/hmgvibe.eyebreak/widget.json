      ] },
    { "key": "rest", "type": "select", "label": { "zh-TW": "每次休息多久", "zh-CN": "每次休息多久", "en": "Each break lasts" }, "default": 20,
      "options": [
        { "value": 20, "label": { "zh-TW": "20 秒", "zh-CN": "20 秒", "en": "20 seconds" } },
        { "value": 60, "label": { "zh-TW": "1 分鐘", "zh-CN": "1 分钟", "en": "1 minute" } },
        { "value": 300, "label": { "zh-TW": "5 分鐘", "zh-CN": "5 分钟", "en": "5 minutes" } }
